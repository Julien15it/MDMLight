@EndUserText.label: 'Entity to expose Value Helps for MDM Light'
define service ZMDML_VH_ENTITY {
  expose I_CountryVH                    as Countries;
  expose I_RegionVH                     as Regions;
  expose I_Language                     as Languages;
  expose I_LanguageText                 as LanguageTexts;
  expose I_AcademicTitleVH              as AcademicTitles;
  expose I_FormOfAddress                as FormsOfAddress;
  expose I_FormOfAddressText            as FormOfAddressTexts;
  expose I_BusPartCategory              as BusinessPartnerCategories;
  expose I_BusPartCategoryText          as BusinessPartnerCategoryTexts;
  expose I_BusinessPartnerGrouping      as BusinessPartnerGroupings;
  expose I_BusinessPartnerGroupingText  as BusinessPartnerGroupingTexts;
  expose I_BusinessPartnerRoleStdVH     as BusinessPartnerRoles;
  expose I_BusinessPartnerType          as BusinessPartnerTypes;
  expose I_BusinessPartnerTypeText      as BusinessPartnerTypeTexts;
  expose I_BusinessPartnerLegalForm     as LegalForms;
  expose I_BusinessPartnerLegalFormText as LegalFormTexts;
  expose I_BusinessPartnerOccupation    as Occupations;
  expose I_BusPartOccupationText        as OccupationTexts;
  expose I_BusinessPartnerPrintFormat   as PrintFormats;
  expose I_BusinessPartnerPrintFormatT  as PrintFormatTexts;
  expose I_BusPartMaritalStatus         as MaritalStatuses;
  expose I_BusPartMaritalStatusText     as MaritalStatusTexts;
  expose I_BusPartBirthDateStatus       as BirthDateStatuses;
  expose I_BusPartBirthDateStatusText   as BirthDateStatusTexts;
  expose I_BPGenderValueHelp            as Genders;
  expose I_BPTradingPartner             as TradingPartners;
  expose I_BuPaIdentificationType       as IdentificationTypes;
  expose I_BusPartTaxTypeText           as TaxTypes;
  expose I_BusPartAddrDepdntTaxTypeVH   as AddressDependentTaxTypes;
  expose I_BusPartIndustrySystem        as IndustrySystems;
  expose I_BusPartIndustrySystemText    as IndustrySystemTexts;
  expose I_BusPartIndustryKey           as IndustrySectors;
  expose I_BusPartIndustryKeyText       as IndustrySectorTexts;
  expose I_BusPartIndustryCode          as IndustryCodes;
  expose I_BusPartIndustryCodeText      as IndustryCodeTexts;
  expose I_BusinessPartnerBank          as Banks;
  expose I_CustomerAccountGroupStdVH    as CustomerAccountGroups;
  expose I_CustomerClassification       as CustomerClassifications;
  expose I_CustomerClassificationText   as CustomerClassificationTexts;
  expose I_SupplierAccountGroupStdVH    as SupplierAccountGroups;
  expose Z_I_CVI_ROLE_CATEGORY          as CviRoleCategories;
  expose Z_I_CVI_BP_ROLE                as CviBusinessPartnerRoles;
  expose Z_I_CVI_CONTACT_MAPPING        as CviContactMapping;
  expose Z_I_CVI_PPO_CONTROL            as CviPostprocessingControl;
  expose Z_I_CVI_NUMBER_RANGE           as CviNumberRanges;
  expose Z_I_CVI_NUM_ASGN_CUSTOMER      as CviCustomerNumberAssignments;
  expose Z_I_CVI_NUM_ASGN_VENDOR        as CviSupplierNumberAssignments;
  expose Z_I_CVI_SYNC_DIRECTION         as CviSyncDirections;
  expose Z_I_CVI_EU_COUNTRY             as CviEuCountries;

  // Derivation sources. `Der`, not `Cvi`: these read general SAP customizing
  // (T005, TTZ5S, TPAKD/TPAR/TPAER, TSTL) and have nothing to do with
  // customer/vendor integration - see abap/valuehelp/deriv/.
  expose Z_I_DER_ADDR_DEFAULT           as DerAddressDefaults;
  expose Z_I_DER_TIME_ZONE              as DerTimeZones;
  expose Z_I_DER_TAX_CATEGORY           as DerTaxCategories;
  expose Z_I_DER_PARTNER_FUNC           as DerPartnerFunctions;
  // Keyed by determination procedure, so not joinable on its own. Superseded for the derivation by
  // DerPartnerFunctionsMandatory below, which carries the TKUPA link; kept exposed because it is
  // the raw procedure table and the next person should not re-derive where it lives.
  expose Z_I_DER_PARTNER_FUNC_PROC      as DerPartnerFunctionProcedures;
  // TKUPA -> TPAER -> TPAR. The account group is the join, and this is what the derivation reads.
  expose Z_I_DER_PARTNER_FUNC_MAND      as DerPartnerFunctionsMandatory;
}
