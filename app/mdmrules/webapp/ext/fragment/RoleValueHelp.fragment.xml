<core:FragmentDefinition
  xmlns="sap.m"
  xmlns:core="sap.ui.core">
  <!--
    The roles an approver step can be assigned to. Typing an e-mail address straight into the cell
    still works and is the common case - this is for the other half, where nobody should have to
    remember how `DataSteward` is spelled.

    `multiSelect`, because a step usually names more than one: picking three roles is one trip
    through the dialog rather than three.

    The list is served by `workflowRuleOptions()` from srv/checks/field-properties.js, so it is the
    same set of roles the field property profiles condition on. It deliberately does NOT include
    `*`: "every role" is not somebody who can approve a request.
  -->
  <SelectDialog
    title="Choose Roles"
    multiSelect="true"
    noDataText="No role matches that search."
    search=".onRoleSearch"
    liveChange=".onRoleSearch"
    confirm=".onRolesChosen"
    growing="true"
    growingThreshold="50"
    items="{ path: 'opt>/roles', templateShareable: false }">
    <StandardListItem
      title="{opt>text}"
      description="{opt>code}"
      type="Active" />
  </SelectDialog>
</core:FragmentDefinition>
