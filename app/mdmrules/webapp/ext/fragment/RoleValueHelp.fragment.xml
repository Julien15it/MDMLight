<core:FragmentDefinition
  xmlns="sap.m"
  xmlns:core="sap.ui.core">
  <!--
    Who can be named as an approver. Typing an e-mail address straight into the cell still works and
    is the common case - this is for picking one from the BTP subaccount instead of remembering it.

    A real two-column table, not sap.m.SelectDialog: a SelectDialog wraps a plain List and has no
    column headers, and Type/Name-or-e-mail is exactly the distinction a picker over BOTH role
    collections and users has to make visible - a bare list of values would leave "SalesApprover"
    and "julien@alluvion.eu" looking like the same kind of thing.

    One entry per cell, because the cell holds one approver: several approvers are several rows,
    which is what the Add button is for and what the engine merges.

    The list is served by `workflowRuleOptions()` (srv/wf/btp-agents.js): the subaccount's own role
    collections, filtered to the ones whose Description starts with MDMLIGHT, and the subaccount's
    users.
  -->
  <Dialog
    id="agentValueHelpDialog"
    title="Choose an Approver"
    contentWidth="28rem"
    contentHeight="26rem"
    resizable="true"
    draggable="true">
    <subHeader>
      <Bar>
        <contentMiddle>
          <SearchField
            width="100%"
            placeholder="Search"
            liveChange=".onRoleSearch"
            search=".onRoleSearch" />
        </contentMiddle>
      </Bar>
    </subHeader>
    <content>
      <Table
        id="agentTable"
        mode="None"
        growing="true"
        growingThreshold="50"
        noDataText="No role or user matches that search."
        items="{ path: 'opt>/agents', templateShareable: false }"
        itemPress=".onRolesChosen">
        <columns>
          <Column width="8rem"><Text text="Type" /></Column>
          <Column><Text text="Name / E-mail" /></Column>
        </columns>
        <items>
          <ColumnListItem type="Active">
            <cells>
              <ObjectStatus
                text="{opt>type}"
                state="{= ${opt>type} === 'Role' ? 'Information' : 'Success' }" />
              <Text text="{opt>value}" />
            </cells>
          </ColumnListItem>
        </items>
      </Table>
    </content>
    <beginButton>
      <Button text="Cancel" press=".onRoleValueHelpCancel" />
    </beginButton>
  </Dialog>
</core:FragmentDefinition>
