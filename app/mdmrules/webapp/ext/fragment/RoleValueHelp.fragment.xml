<core:FragmentDefinition
  xmlns="sap.m"
  xmlns:core="sap.ui.core">
  <!--
    Who can be named as an approver - a role, spelled exactly as SBPA knows it, picked from the BTP
    subaccount instead of remembered. Typing straight into the cell still works too.

    One entry per cell, because the cell holds one approver: several approvers are several rows,
    which is what the Add button is for and what the engine merges.

    The list is served by `workflowRuleOptions()` (srv/duplicate-config-service.js), filtered to the
    subaccount's own role collections whose Description starts with MDMLIGHT - a typed e-mail address
    is no longer offered here (withdrawn 2026-09-07, see workflow.md), so this is a plain single-column
    list rather than the two-column Type/Name-or-e-mail table it used to need.
  -->
  <Dialog
    id="agentValueHelpDialog"
    title="Choose an Approver"
    contentWidth="28rem"
    contentHeight="26rem"
    resizable="true"
    draggable="true">
    <subHeader>
      <Bar>
        <contentMiddle>
          <SearchField
            width="100%"
            placeholder="Search"
            liveChange=".onRoleSearch"
            search=".onRoleSearch" />
        </contentMiddle>
      </Bar>
    </subHeader>
    <content>
      <Table
        id="agentTable"
        mode="None"
        growing="true"
        growingThreshold="50"
        noDataText="No role matches that search."
        items="{ path: 'opt>/agents', templateShareable: false }"
        itemPress=".onRolesChosen">
        <columns>
          <Column><Text text="Role" /></Column>
        </columns>
        <items>
          <ColumnListItem type="Active">
            <cells>
              <Text text="{opt>value}" />
            </cells>
          </ColumnListItem>
        </items>
      </Table>
    </content>
    <beginButton>
      <Button text="Cancel" press=".onRoleValueHelpCancel" />
    </beginButton>
  </Dialog>
</core:FragmentDefinition>
