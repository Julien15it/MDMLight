<mvc:View
  controllerName="mdm.md.mdmrules.manage.ext.controller.DuplicateRuleList"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns:core="sap.ui.core"
  xmlns="sap.m"
  height="100%">
  <Page
    title="Duplicate Check Rules"
    showNavButton="true"
    navButtonPress=".onBackToList">
    <content>
      <!-- Shown only when the configuration is empty or unusable, because that is the case a
           steward would otherwise read as “the check is off”. -->
      <MessageStrip
        class="sapUiSmallMarginBeginEnd"
        visible="{= ${view>/source} === 'defaults' }"
        text="No usable rules are configured, so the built-in defaults are running. The duplicate check is never switched off by an empty table."
        type="Warning"
        showIcon="true" />
      <!-- Five condition slots since 2026-09-01, two of them drawn until "Add Condition" reveals the
           next Logic/Condition pair - the same rollout Workflow Agent Determination got. Horizontal
           scrolling so revealing one widens the table instead of squeezing every cell;
           `view>/tableWidth` is the other half of it, because a fixed-layout table at
           `width="100%"` redistributes its columns into whatever space it has. -->
      <ScrollContainer horizontal="true" vertical="false" width="100%">
      <Table
        id="ruleTable"
        width="{view>/tableWidth}"
        items="{ path: 'dc>/DuplicateRules', parameters: { $orderby: 'createdAt', $$updateGroupId: 'ruleChanges' } }"
        mode="SingleSelectMaster"
        busy="{view>/busy}"
        growing="true"
        growingThreshold="100">
        <headerToolbar>
          <OverflowToolbar>
            <Title text="Rules" level="H2" />
            <ToolbarSpacer />
            <Button text="Add Rule" icon="sap-icon://add" type="Transparent" press=".onAddRule" />
            <!-- Table-wide, not per row: it reveals the next Logic/Condition COLUMN pair for every
                 rule at once. Delete Condition removes the last one and clears it on every row, so
                 nothing is left matching in a column nobody can see. -->
            <Button
              text="Add Condition"
              icon="sap-icon://add-filter"
              type="Transparent"
              enabled="{= ${view>/conditions} &lt; ${view>/maxConditions} }"
              press=".onAddCondition" />
            <Button
              text="Delete Condition"
              icon="sap-icon://less"
              type="Transparent"
              enabled="{= ${view>/conditions} &gt; 1 }"
              press=".onDeleteCondition" />
            <Button text="Duplicate" icon="sap-icon://copy" type="Transparent" press=".onDuplicateRule" />
            <Button text="Delete" icon="sap-icon://delete" type="Transparent" press=".onDeleteRule" />
            <Button text="Test Against Current BPs" icon="sap-icon://lab" type="Transparent" press=".onTestRuleset" />
            <ToolbarSeparator />
            <Button text="Export to Excel" icon="sap-icon://excel-attachment" type="Transparent" press=".onExportExcel" />
            <Button text="Import from Excel" icon="sap-icon://upload" type="Transparent" press=".onImportExcel" />
            <ToolbarSeparator />
            <Button text="Save" icon="sap-icon://save" type="Emphasized" press=".onSave" enabled="{view>/dirty}" />
            <Button text="Discard" icon="sap-icon://undo" type="Transparent" press=".onDiscard" enabled="{view>/dirty}" />
          </OverflowToolbar>
        </headerToolbar>
        <!-- Fixed widths in rem, not percentages: a hidden column contributes no share of 100%. -->
        <columns>
          <Column width="14rem"><Text text="Condition 1 Field" /></Column>
          <Column width="9rem"><Text text="Condition 1 Value" /></Column>
          <!-- Titleless on purpose: AND / OR / NOR reads as the joining word between the two
               conditions it sits between, and a heading would only repeat what the cell says. -->
          <Column width="6rem" hAlign="Center"><Text text="" /></Column>
          <Column width="14rem"><Text text="Condition 2 Field" /></Column>
          <Column width="9rem"><Text text="Condition 2 Value" /></Column>
          <Column width="6rem" hAlign="Center" visible="{= ${view>/conditions} &gt;= 3 }"><Text text="" /></Column>
          <Column width="14rem" visible="{= ${view>/conditions} &gt;= 3 }"><Text text="Condition 3 Field" /></Column>
          <Column width="9rem" visible="{= ${view>/conditions} &gt;= 3 }"><Text text="Condition 3 Value" /></Column>
          <Column width="6rem" hAlign="Center" visible="{= ${view>/conditions} &gt;= 4 }"><Text text="" /></Column>
          <Column width="14rem" visible="{= ${view>/conditions} &gt;= 4 }"><Text text="Condition 4 Field" /></Column>
          <Column width="9rem" visible="{= ${view>/conditions} &gt;= 4 }"><Text text="Condition 4 Value" /></Column>
          <Column width="6rem" hAlign="Center" visible="{= ${view>/conditions} &gt;= 5 }"><Text text="" /></Column>
          <Column width="14rem" visible="{= ${view>/conditions} &gt;= 5 }"><Text text="Condition 5 Field" /></Column>
          <Column width="9rem" visible="{= ${view>/conditions} &gt;= 5 }"><Text text="Condition 5 Value" /></Column>
          <Column width="18rem"><Text text="Field" /></Column>
          <Column width="15rem"><Text text="Comparison" /></Column>
          <Column width="15rem"><Text text="Indicator" /></Column>
          <Column width="4rem" hAlign="Center"><Text text="Active" /></Column>
        </columns>
        <items>
          <ColumnListItem>
            <cells>
              <!-- Conditions over any catalog field: Role = Vendor and Country = BE, then compare
                   Tax Number. All are optional and independent; leave them empty and the rule
                   applies to every partner.

                   `targetType: 'any'` on every `dc>` reference inside an expression binding: without
                   it UI5 formats the referenced property into the type of the BOUND property - a
                   Boolean here - and a String value throws a FormatException, leaving the cell at
                   its default. See CLAUDE.md, "Workflow Agent Determination". -->
              <ComboBox
                width="100%"
                selectedKey="{dc>conditionField}"
                placeholder="any"
                items="{ path: 'opt>/fields', templateShareable: false }"
                change=".onCellChange">
                <core:Item key="{opt>code}" text="{opt>text}" />
              </ComboBox>
              <Input
                width="100%"
                value="{dc>conditionValue}"
                placeholder="any, or Value1|Value2"
                enabled="{= !!${path: 'dc>conditionField', targetType: 'any'} }"
                change=".onCellChange" />
              <!-- Only enabled once BOTH of the conditions it joins are filled: there is nothing to
                   join otherwise, and NOR on a single condition would silently invert it. -->
              <ComboBox
                width="100%"
                selectedKey="{dc>conditionLogic}"
                enabled="{= !!${path: 'dc>conditionField', targetType: 'any'} &amp;&amp; !!${path: 'dc>conditionField2', targetType: 'any'} }"
                items="{ path: 'opt>/conditionLogics', templateShareable: false }"
                change=".onCellChange">
                <core:Item key="{opt>code}" text="{opt>text}" />
              </ComboBox>
              <ComboBox
                width="100%"
                selectedKey="{dc>conditionField2}"
                placeholder="any"
                items="{ path: 'opt>/fields', templateShareable: false }"
                change=".onCellChange">
                <core:Item key="{opt>code}" text="{opt>text}" />
              </ComboBox>
              <Input
                width="100%"
                value="{dc>conditionValue2}"
                placeholder="any, or Value1|Value2"
                enabled="{= !!${path: 'dc>conditionField2', targetType: 'any'} }"
                change=".onCellChange" />
              <ComboBox
                width="100%"
                selectedKey="{dc>conditionLogic2}"
                enabled="{= !!${path: 'dc>conditionField2', targetType: 'any'} &amp;&amp; !!${path: 'dc>conditionField3', targetType: 'any'} }"
                items="{ path: 'opt>/conditionLogics', templateShareable: false }"
                change=".onCellChange">
                <core:Item key="{opt>code}" text="{opt>text}" />
              </ComboBox>
              <ComboBox
                width="100%"
                selectedKey="{dc>conditionField3}"
                placeholder="any"
                items="{ path: 'opt>/fields', templateShareable: false }"
                change=".onCellChange">
                <core:Item key="{opt>code}" text="{opt>text}" />
              </ComboBox>
              <Input
                width="100%"
                value="{dc>conditionValue3}"
                placeholder="any, or Value1|Value2"
                enabled="{= !!${path: 'dc>conditionField3', targetType: 'any'} }"
                change=".onCellChange" />
              <ComboBox
                width="100%"
                selectedKey="{dc>conditionLogic3}"
                enabled="{= !!${path: 'dc>conditionField3', targetType: 'any'} &amp;&amp; !!${path: 'dc>conditionField4', targetType: 'any'} }"
                items="{ path: 'opt>/conditionLogics', templateShareable: false }"
                change=".onCellChange">
                <core:Item key="{opt>code}" text="{opt>text}" />
              </ComboBox>
              <ComboBox
                width="100%"
                selectedKey="{dc>conditionField4}"
                placeholder="any"
                items="{ path: 'opt>/fields', templateShareable: false }"
                change=".onCellChange">
                <core:Item key="{opt>code}" text="{opt>text}" />
              </ComboBox>
              <Input
                width="100%"
                value="{dc>conditionValue4}"
                placeholder="any, or Value1|Value2"
                enabled="{= !!${path: 'dc>conditionField4', targetType: 'any'} }"
                change=".onCellChange" />
              <ComboBox
                width="100%"
                selectedKey="{dc>conditionLogic4}"
                enabled="{= !!${path: 'dc>conditionField4', targetType: 'any'} &amp;&amp; !!${path: 'dc>conditionField5', targetType: 'any'} }"
                items="{ path: 'opt>/conditionLogics', templateShareable: false }"
                change=".onCellChange">
                <core:Item key="{opt>code}" text="{opt>text}" />
              </ComboBox>
              <ComboBox
                width="100%"
                selectedKey="{dc>conditionField5}"
                placeholder="any"
                items="{ path: 'opt>/fields', templateShareable: false }"
                change=".onCellChange">
                <core:Item key="{opt>code}" text="{opt>text}" />
              </ComboBox>
              <Input
                width="100%"
                value="{dc>conditionValue5}"
                placeholder="any, or Value1|Value2"
                enabled="{= !!${path: 'dc>conditionField5', targetType: 'any'} }"
                change=".onCellChange" />
              <VBox>
                <!-- Options come from ruleOptions(); the UI never keeps its own copy of the
                     catalog, because that copy is what goes stale. -->
                <ComboBox
                  width="100%"
                  selectedKey="{dc>field}"
                  items="{ path: 'opt>/fields', templateShareable: false }"
                  change=".onFieldChange">
                  <core:Item key="{opt>code}" text="{opt>text}" />
                </ComboBox>
                <Text
                  class="sapUiTinyMarginTop"
                  visible="{= ${view>/unindexed}[${path: 'dc>field', targetType: 'any'}] === true }"
                  text="Not held in the duplicate index — this cannot match an existing partner."
                  wrapping="true" />
              </VBox>
              <ComboBox
                width="100%"
                selectedKey="{dc>comparison}"
                items="{ path: 'opt>/comparisons', templateShareable: false }"
                change=".onCellChange">
                <core:Item key="{opt>code}" text="{opt>text}" />
              </ComboBox>
              <ComboBox
                width="100%"
                selectedKey="{dc>indicator}"
                items="{ path: 'opt>/indicators', templateShareable: false }"
                change=".onCellChange">
                <core:Item key="{opt>code}" text="{opt>text}" />
              </ComboBox>
              <CheckBox selected="{dc>isActive}" select=".onCellChange" />
            </cells>
          </ColumnListItem>
        </items>
      </Table>
      </ScrollContainer>
    </content>
  </Page>
</mvc:View>
