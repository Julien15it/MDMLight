<mvc:View
  controllerName="mdm.md.mdmrules.manage.ext.controller.DuplicateRuleList"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns:core="sap.ui.core"
  xmlns:app="http://schemas.sap.com/sapui5/extension/sap.ui.core.CustomData/1"
  xmlns="sap.m"
  height="100%">
  <Page
    title="Duplicate Check Rules"
    showNavButton="true"
    navButtonPress=".onBackToList">
    <content>
      <!-- Shown only when the configuration is empty or unusable, because that is the case a
           steward would otherwise read as “the check is off”. -->
      <MessageStrip
        class="sapUiSmallMarginBeginEnd"
        visible="{= ${view>/source} === 'defaults' }"
        text="No usable rules are configured, so the built-in defaults are running. The duplicate check is never switched off by an empty table."
        type="Warning"
        showIcon="true" />
      <Table
        id="ruleTable"
        items="{ path: 'dc>/DuplicateRules', parameters: { $orderby: 'createdAt', $$updateGroupId: 'ruleChanges' } }"
        mode="SingleSelectMaster"
        busy="{view>/busy}"
        growing="true"
        growingThreshold="100"
        updateFinished=".onRowsRendered">
        <headerToolbar>
          <OverflowToolbar>
            <Title text="Rules" level="H2" />
            <ToolbarSpacer />
            <Button text="Add Rule" icon="sap-icon://add" type="Transparent" press=".onAddRule" />
            <Button text="Delete" icon="sap-icon://delete" type="Transparent" press=".onDeleteRule" />
            <Button text="Test Against Current BPs" icon="sap-icon://lab" type="Transparent" press=".onTestRuleset" />
            <Button text="Save" icon="sap-icon://save" type="Emphasized" press=".onSave" enabled="{view>/dirty}" />
            <Button text="Discard" icon="sap-icon://undo" type="Transparent" press=".onDiscard" enabled="{view>/dirty}" />
          </OverflowToolbar>
        </headerToolbar>
        <!-- Percentage widths: without them every cell shrinks to its content and the row reads as
             scattered controls with gaps between them. -->
        <columns>
          <Column width="12%"><Text text="Condition 1 Field" /></Column>
          <Column width="10%"><Text text="Condition 1 Values" /></Column>
          <Column width="12%"><Text text="Condition 2 Field" /></Column>
          <Column width="10%"><Text text="Condition 2 Values" /></Column>
          <Column width="18%"><Text text="Field" /></Column>
          <Column width="17%"><Text text="Comparison" /></Column>
          <Column width="17%"><Text text="Indicator" /></Column>
          <Column width="4rem" hAlign="Center"><Text text="Active" /></Column>
        </columns>
        <items>
          <ColumnListItem>
            <cells>
              <!-- Two conditions, any catalog field: Role = Vendor and Country = BE, then compare
                   Tax Number. Both are optional and independent; leave them empty and the rule
                   applies to every partner. -->
              <ComboBox
                width="100%"
                selectedKey="{dc>conditionField}"
                placeholder="any"
                items="{ path: 'opt>/fields', templateShareable: false }"
                change=".onCellChange">
                <core:Item key="{opt>code}" text="{opt>text}" />
              </ComboBox>
              <!-- A LIST of values, one token each, and they are OR: one match is enough, so
                   "Country is BE, NL, FR or DE" is one rule rather than four. Nobody types the
                   delimiter it is stored with - see app/mdmrules/webapp/ext/ListCell.js. -->
              <VBox>
                <MultiInput
                  width="100%"
                  placeholder="any"
                  enabled="{= !!${dc>conditionField} }"
                  app:listPath="conditionValue"
                  tokenUpdate=".onListTokenUpdate"
                  submit=".onListSubmit"
                  change=".onListChange" />
                <!-- The control that actually WRITES the column. The MultiInput above is the
                     display: its tokens are an aggregation, and a `context.setProperty` write
                     reached the client model but never the server (2026-08-21). Every column on
                     this page that saves is written by a two-way binding, so this one is too. -->
                <Input
                  visible="false"
                  value="{dc>conditionValue}"
                  app:listSink="conditionValue" />
              </VBox>
              <ComboBox
                width="100%"
                selectedKey="{dc>conditionField2}"
                placeholder="any"
                items="{ path: 'opt>/fields', templateShareable: false }"
                change=".onCellChange">
                <core:Item key="{opt>code}" text="{opt>text}" />
              </ComboBox>
              <!-- A LIST of values, one token each, and they are OR: one match is enough, so
                   "Country is BE, NL, FR or DE" is one rule rather than four. Nobody types the
                   delimiter it is stored with - see app/mdmrules/webapp/ext/ListCell.js. -->
              <VBox>
                <MultiInput
                  width="100%"
                  placeholder="any"
                  enabled="{= !!${dc>conditionField2} }"
                  app:listPath="conditionValue2"
                  tokenUpdate=".onListTokenUpdate"
                  submit=".onListSubmit"
                  change=".onListChange" />
                <!-- The control that actually WRITES the column. The MultiInput above is the
                     display: its tokens are an aggregation, and a `context.setProperty` write
                     reached the client model but never the server (2026-08-21). Every column on
                     this page that saves is written by a two-way binding, so this one is too. -->
                <Input
                  visible="false"
                  value="{dc>conditionValue2}"
                  app:listSink="conditionValue2" />
              </VBox>
              <VBox>
                <!-- Options come from ruleOptions(); the UI never keeps its own copy of the
                     catalog, because that copy is what goes stale. -->
                <ComboBox
                  width="100%"
                  selectedKey="{dc>field}"
                  items="{ path: 'opt>/fields', templateShareable: false }"
                  change=".onFieldChange">
                  <core:Item key="{opt>code}" text="{opt>text}" />
                </ComboBox>
                <Text
                  class="sapUiTinyMarginTop"
                  visible="{= ${view>/unindexed}[${dc>field}] === true }"
                  text="Not held in the duplicate index — this cannot match an existing partner."
                  wrapping="true" />
              </VBox>
              <ComboBox
                width="100%"
                selectedKey="{dc>comparison}"
                items="{ path: 'opt>/comparisons', templateShareable: false }"
                change=".onCellChange">
                <core:Item key="{opt>code}" text="{opt>text}" />
              </ComboBox>
              <ComboBox
                width="100%"
                selectedKey="{dc>indicator}"
                items="{ path: 'opt>/indicators', templateShareable: false }"
                change=".onCellChange">
                <core:Item key="{opt>code}" text="{opt>text}" />
              </ComboBox>
              <CheckBox selected="{dc>isActive}" select=".onCellChange" />
            </cells>
          </ColumnListItem>
        </items>
      </Table>
    </content>
  </Page>
</mvc:View>
