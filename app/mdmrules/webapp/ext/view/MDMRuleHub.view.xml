<mvc:View
  controllerName="mdm.md.mdmrules.manage.ext.controller.MDMRuleHub"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  height="100%">
  <Page
    title="MDM Configuration Panel"
    showNavButton="true"
    navButtonPress=".onBackToSite">
    <content>
      <!-- Saying it is courtesy; the service checks the scope on every call regardless. -->
      <MessageStrip
        class="sapUiSmallMargin"
        visible="{= !${perm>/isDataSteward} }"
        text="Rule configuration is limited to data stewards. You can look, but saving will be refused."
        type="Information"
        showIcon="true" />
      <VBox class="sapUiSmallMargin">
        <Title text="Choose what to configure" level="H2" class="sapUiSmallMarginBottom" />
        <HBox wrap="Wrap">
          <GenericTile
            class="sapUiTinyMargin"
            header="Duplicate Check Rules"
            subheader="Which fields make two partners the same"
            press=".onDuplicateRules">
            <TileContent>
              <ImageContent src="sap-icon://duplicate" />
            </TileContent>
          </GenericTile>
          <GenericTile
            class="sapUiTinyMargin"
            header="Validation Rules"
            subheader="What blocks or warns on a request"
            press=".onValidationRules">
            <TileContent>
              <ImageContent src="sap-icon://validate" />
            </TileContent>
          </GenericTile>
          <GenericTile
            class="sapUiTinyMargin"
            header="Field Properties"
            subheader="Which fields are mandatory, read-only or hidden, and for whom"
            press=".onFieldProperties">
            <TileContent>
              <ImageContent src="sap-icon://form" />
            </TileContent>
          </GenericTile>
          <GenericTile
            class="sapUiTinyMargin"
            header="Workflow Agent Determination"
            subheader="Who approves which change request, and under what conditions"
            press=".onWorkflowRules">
            <TileContent>
              <ImageContent src="sap-icon://workflow-tasks" />
            </TileContent>
          </GenericTile>
          <GenericTile
            class="sapUiTinyMargin"
            header="Derivation Rules"
            subheader="Which empty fields get filled in, and from where"
            press=".onDerivationRules">
            <TileContent>
              <ImageContent src="sap-icon://download-from-cloud" />
            </TileContent>
          </GenericTile>
        </HBox>
      </VBox>

      <!-- One installation-wide switch, not a per-user preference: a customer who
           decided against AI should not depend on every user leaving it alone. -->
      <Panel class="sapUiSmallMargin" headerText="AI assistance" expandable="true" expanded="true">
        <VBox class="sapUiSmallMargin">
          <HBox alignItems="Center" class="sapUiSmallMarginBottom">
            <Switch
              id="aiAssistanceSwitch"
              state="{perm>/aiAssistanceEnabled}"
              enabled="{perm>/isDataSteward}"
              customTextOn="On"
              customTextOff="Off"
              change=".onToggleAiAssistance" />
            <Text
              class="sapUiSmallMarginBegin"
              text="{= ${perm>/aiAssistanceEnabled}
                ? 'The assistant answers with a language model, and normalisation proposals are offered.'
                : 'No request reaches a language model. The assistant is withdrawn from the Business Partner app.' }" />
          </HBox>
          <Text
            class="sapUiTinyMarginTop"
            text="Covers the three places a language model is used: the assistant's answer, intent recognition and normalisation proposals. The duplicate check, fuzzy name matching and the VIES and GLEIF look-ups are not language models and stay on." />
        </VBox>
      </Panel>
    </content>
  </Page>
</mvc:View>
