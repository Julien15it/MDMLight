<mvc:View
  controllerName="mdm.md.mdmrules.manage.ext.controller.WorkflowRuleList"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns:core="sap.ui.core"
  xmlns="sap.m"
  height="100%">
  <Page
    title="Workflow Agent Determination"
    showNavButton="true"
    navButtonPress=".onBackToHub">
    <content>
      <!--
        A decision table like the other three, and read the same way left to right - "a create
        request whose Country is BE, NL, FR or DE is approved by these three people". A rule's
        conditions render side by side, as many as it has - "Add Condition" grows that row only, the
        way the first two condition slots always looked, never stacked as lines of text. Approvers
        stay a list of ROWS instead: several approvers is several rules, which is what "Duplicate" is
        for.
      -->
      <MessageStrip
        class="sapUiSmallMarginBeginEnd sapUiSmallMarginTop"
        visible="{= ${view>/skipped} > 0 }"
        text="{view>/skippedText}"
        type="Warning"
        showIcon="true" />
      <Table
        id="ruleTable"
        items="{ path: 'dc>/WorkflowRules', parameters: { $orderby: 'createdAt', $$updateGroupId: 'ruleChanges', $expand: 'conditions' } }"
        mode="SingleSelectMaster"
        busy="{view>/busy}"
        growing="true"
        growingThreshold="100">
        <headerToolbar>
          <OverflowToolbar>
            <Title text="Rules" level="H2" />
            <ToolbarSpacer />
            <Button text="Add Rule" icon="sap-icon://add" type="Transparent" press=".onAddRule" />
            <Button text="Duplicate" icon="sap-icon://copy" type="Transparent" press=".onDuplicateRule" />
            <Button text="Delete" icon="sap-icon://delete" type="Transparent" press=".onDeleteRule" />
            <ToolbarSeparator />
            <Button text="Export to Excel" icon="sap-icon://excel-attachment" type="Transparent" press=".onExportExcel" />
            <Button text="Import from Excel" icon="sap-icon://upload" type="Transparent" press=".onImportExcel" />
            <ToolbarSeparator />
            <Button text="Save" icon="sap-icon://save" type="Emphasized" press=".onSave" enabled="{view>/dirty}" />
            <Button text="Discard" icon="sap-icon://undo" type="Transparent" press=".onDiscard" enabled="{view>/dirty}" />
          </OverflowToolbar>
        </headerToolbar>
        <!-- Percentage widths: without them every cell shrinks to its content and the row reads as
             scattered controls with gaps between them. -->
        <columns>
          <Column width="10%"><Text text="CR Type" /></Column>
          <Column width="8%"><Text text="Step" /></Column>
          <!-- As many conditions as the rule needs, side by side - see db/workflow-rules.cds. -->
          <Column width="34%"><Text text="Conditions" /></Column>
          <Column width="9%"><Text text="Logic" /></Column>
          <Column width="26%"><Text text="Approvers" /></Column>
          <Column width="4rem" hAlign="Center"><Text text="Active" /></Column>
        </columns>
        <items>
          <ColumnListItem>
            <cells>
              <!-- All four CR types, and no "any": an approver list is not something to default. -->
              <ComboBox
                width="100%"
                selectedKey="{dc>requestType}"
                items="{ path: 'opt>/requestTypes', templateShareable: false }"
                change=".onCellChange">
                <core:Item key="{opt>code}" text="{opt>text}" />
              </ComboBox>
              <!-- One entry today. A column rather than an assumption - see db/workflow-rules.cds. -->
              <ComboBox
                width="100%"
                selectedKey="{dc>step}"
                items="{ path: 'opt>/steps', templateShareable: false }"
                change=".onCellChange">
                <core:Item key="{opt>code}" text="{opt>text}" />
              </ComboBox>
              <!-- As many conditions as the rule needs, side by side - "Add Condition" grows THIS
                   row's own composition (WorkflowRuleConditions), never a shared column count. Wraps
                   onto a second line inside the cell rather than growing the row forever sideways. -->
              <VBox>
                <FlexBox wrap="Wrap" items="{ path: 'dc>conditions', templateShareable: false }">
                  <HBox class="sapUiTinyMarginEnd sapUiTinyMarginBottom" alignItems="Center">
                    <Input
                      width="9rem"
                      value="{dc>field}"
                      placeholder="Field"
                      showValueHelp="true"
                      valueHelpRequest=".onFieldValueHelp"
                      change=".onCellChange" />
                    <Select
                      width="6.5rem"
                      class="sapUiTinyMarginBeginEnd"
                      selectedKey="{dc>operator}"
                      items="{ path: 'opt>/comparisons', templateShareable: false }"
                      change=".onCellChange">
                      <core:Item key="{opt>code}" text="{opt>text}" />
                    </Select>
                    <Input
                      width="7rem"
                      value="{dc>values}"
                      placeholder="Value1|Value2"
                      enabled="{= ${dc>operator} !== 'empty' &amp;&amp; ${dc>operator} !== 'notEmpty' }"
                      change=".onCellChange" />
                    <Button
                      icon="sap-icon://decline"
                      type="Transparent"
                      tooltip="Remove this condition"
                      press=".onRemoveCondition" />
                  </HBox>
                </FlexBox>
                <Button
                  text="Add Condition"
                  icon="sap-icon://add"
                  type="Transparent"
                  press=".onAddCondition" />
              </VBox>
              <!-- Always enabled: with zero or one condition the engine ignores this column entirely
                   (see joinConditions in srv/checks/value-lists.js), so there is nothing unsafe about
                   it being set ahead of a second condition being added. -->
              <ComboBox
                width="100%"
                selectedKey="{dc>conditionLogic}"
                items="{ path: 'opt>/conditionLogics', templateShareable: false }"
                change=".onCellChange">
                <core:Item key="{opt>code}" text="{opt>text}" />
              </ComboBox>
              <!-- ONE approver: an e-mail address or a role. An entry carrying an `@` goes to SBPA
                   as a user and anything else as a role; which roles RESOLVE to is SBPA's to know,
                   not ours. Several approvers means several rows - the engine merges them. The value
                   help is for the roles, so nobody has to remember how DataSteward is spelled. -->
              <Input
                width="100%"
                value="{dc>approvers}"
                placeholder="e-mail or role"
                showValueHelp="true"
                valueHelpRequest=".onRoleValueHelp"
                change=".onCellChange" />
              <CheckBox selected="{dc>isActive}" select=".onCellChange" />
            </cells>
          </ColumnListItem>
        </items>
      </Table>
    </content>
  </Page>
</mvc:View>
