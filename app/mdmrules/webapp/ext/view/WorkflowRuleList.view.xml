<mvc:View
  controllerName="mdm.md.mdmrules.manage.ext.controller.WorkflowRuleList"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns:core="sap.ui.core"
  xmlns="sap.m"
  height="100%">
  <Page
    title="Workflow Agent Determination"
    showNavButton="true"
    navButtonPress=".onBackToHub">
    <content>
      <!--
        A decision table like the other three, and read the same way left to right - "a create
        request whose Country is BE, NL, FR or DE is approved by these three people". Two fixed
        condition slots (reverted 2026-08-31, back to how it originally was), each field/operator/
        value, joined by one Logic combo - not the dynamic, unbounded composition this briefly became.
        Approvers stay a list of ROWS: several approvers is several rules, which is what "Duplicate"
        is for.
      -->
      <MessageStrip
        class="sapUiSmallMarginBeginEnd sapUiSmallMarginTop"
        visible="{= ${view>/skipped} > 0 }"
        text="{view>/skippedText}"
        type="Warning"
        showIcon="true" />
      <Table
        id="ruleTable"
        items="{ path: 'dc>/WorkflowRules', parameters: { $orderby: 'createdAt', $$updateGroupId: 'ruleChanges' } }"
        mode="SingleSelectMaster"
        busy="{view>/busy}"
        growing="true"
        growingThreshold="100">
        <headerToolbar>
          <OverflowToolbar>
            <Title text="Rules" level="H2" />
            <ToolbarSpacer />
            <Button text="Add Rule" icon="sap-icon://add" type="Transparent" press=".onAddRule" />
            <Button text="Duplicate" icon="sap-icon://copy" type="Transparent" press=".onDuplicateRule" />
            <Button text="Delete" icon="sap-icon://delete" type="Transparent" press=".onDeleteRule" />
            <ToolbarSeparator />
            <Button text="Export to Excel" icon="sap-icon://excel-attachment" type="Transparent" press=".onExportExcel" />
            <Button text="Import from Excel" icon="sap-icon://upload" type="Transparent" press=".onImportExcel" />
            <ToolbarSeparator />
            <Button text="Save" icon="sap-icon://save" type="Emphasized" press=".onSave" enabled="{view>/dirty}" />
            <Button text="Discard" icon="sap-icon://undo" type="Transparent" press=".onDiscard" enabled="{view>/dirty}" />
          </OverflowToolbar>
        </headerToolbar>
        <!-- Percentage widths: without them every cell shrinks to its content and the row reads as
             scattered controls with gaps between them. -->
        <columns>
          <Column width="9%"><Text text="CR Type" /></Column>
          <Column width="7%"><Text text="Step" /></Column>
          <Column width="26%"><Text text="Condition 1" /></Column>
          <Column width="8%"><Text text="Logic" /></Column>
          <Column width="26%"><Text text="Condition 2" /></Column>
          <Column width="20%"><Text text="Approvers" /></Column>
          <Column width="4rem" hAlign="Center"><Text text="Active" /></Column>
        </columns>
        <items>
          <ColumnListItem>
            <cells>
              <!-- All four CR types plus "Any" (2026-08-31, asked for) - an explicit choice a steward
                   picks on a row, so one rule can cover every type instead of four copies of it. -->
              <ComboBox
                width="100%"
                selectedKey="{dc>requestType}"
                items="{ path: 'opt>/requestTypes', templateShareable: false }"
                change=".onCellChange">
                <core:Item key="{opt>code}" text="{opt>text}" />
              </ComboBox>
              <!-- One entry today. A column rather than an assumption - see db/workflow-rules.cds. -->
              <ComboBox
                width="100%"
                selectedKey="{dc>step}"
                items="{ path: 'opt>/steps', templateShareable: false }"
                change=".onCellChange">
                <core:Item key="{opt>code}" text="{opt>text}" />
              </ComboBox>
              <!-- Condition 1: field (value help), operator, value - a plain bound scalar triple,
                   nothing dynamic. -->
              <HBox alignItems="Center">
                <Input
                  width="9rem"
                  value="{dc>conditionField}"
                  placeholder="Field"
                  showValueHelp="true"
                  valueHelpRequest=".onFieldValueHelp"
                  change=".onCellChange" />
                <Select
                  width="6.5rem"
                  class="sapUiTinyMarginBeginEnd"
                  selectedKey="{dc>conditionOperator}"
                  items="{ path: 'opt>/comparisons', templateShareable: false }"
                  change=".onCellChange">
                  <core:Item key="{opt>code}" text="{opt>text}" />
                </Select>
                <Input
                  width="7rem"
                  value="{dc>conditionValues}"
                  placeholder="Value1|Value2"
                  enabled="{= ${dc>conditionOperator} !== 'empty' &amp;&amp; ${dc>conditionOperator} !== 'notEmpty' }"
                  change=".onCellChange" />
              </HBox>
              <!-- Always enabled: with one condition blank the engine ignores this column entirely
                   (see joinConditions in srv/checks/value-lists.js), so there is nothing unsafe about
                   it being set ahead of the second condition being filled in. -->
              <ComboBox
                width="100%"
                selectedKey="{dc>conditionLogic}"
                items="{ path: 'opt>/conditionLogics', templateShareable: false }"
                change=".onCellChange">
                <core:Item key="{opt>code}" text="{opt>text}" />
              </ComboBox>
              <!-- Condition 2: same shape as Condition 1. -->
              <HBox alignItems="Center">
                <Input
                  width="9rem"
                  value="{dc>conditionField2}"
                  placeholder="Field"
                  showValueHelp="true"
                  valueHelpRequest=".onFieldValueHelp"
                  change=".onCellChange" />
                <Select
                  width="6.5rem"
                  class="sapUiTinyMarginBeginEnd"
                  selectedKey="{dc>conditionOperator2}"
                  items="{ path: 'opt>/comparisons', templateShareable: false }"
                  change=".onCellChange">
                  <core:Item key="{opt>code}" text="{opt>text}" />
                </Select>
                <Input
                  width="7rem"
                  value="{dc>conditionValues2}"
                  placeholder="Value1|Value2"
                  enabled="{= ${dc>conditionOperator2} !== 'empty' &amp;&amp; ${dc>conditionOperator2} !== 'notEmpty' }"
                  change=".onCellChange" />
              </HBox>
              <!-- ONE approver: an e-mail address or a role. An entry carrying an `@` goes to SBPA
                   as a user and anything else as a role; which roles RESOLVE to is SBPA's to know,
                   not ours. Several approvers means several rows - the engine merges them. The value
                   help is for the roles, so nobody has to remember how DataSteward is spelled. -->
              <Input
                width="100%"
                value="{dc>approvers}"
                placeholder="e-mail or role"
                showValueHelp="true"
                valueHelpRequest=".onRoleValueHelp"
                change=".onCellChange" />
              <CheckBox selected="{dc>isActive}" select=".onCellChange" />
            </cells>
          </ColumnListItem>
        </items>
      </Table>
    </content>
  </Page>
</mvc:View>
