<mvc:View
  controllerName="mdm.md.mdmrules.manage.ext.controller.DerivationRuleList"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns:core="sap.ui.core"
  xmlns="sap.m"
  height="100%">
  <Page
    title="Derivation Rules"
    showNavButton="true"
    navButtonPress=".onBackToHub">
    <content>
      <!--
        Same decision-table shape as the validation and duplicate rule tables. Read a row as one
        sentence: "where Country is BE, fill Language with NL".
      -->
      <MessageStrip
        class="sapUiSmallMarginBeginEnd sapUiSmallMarginTop"
        visible="{= ${view>/skipped} > 0 }"
        text="{view>/skippedText}"
        type="Warning"
        showIcon="true" />
      <!-- No standing explanation of what a derivation is: the "Copied from" hint under a Value cell
           says the one thing the columns do not, and says it where it applies. -->
      <Table
        id="ruleTable"
        items="{ path: 'dc>/DerivationRules', parameters: { $orderby: 'sequence,createdAt', $$updateGroupId: 'ruleChanges' } }"
        mode="SingleSelectMaster"
        busy="{view>/busy}"
        growing="true"
        growingThreshold="100">
        <headerToolbar>
          <OverflowToolbar>
            <Title text="Rules" level="H2" />
            <ToolbarSpacer />
            <Button text="Add Rule" icon="sap-icon://add" type="Transparent" press=".onAddRule" />
            <Button text="Duplicate" icon="sap-icon://copy" type="Transparent" press=".onDuplicateRule" />
            <Button text="Delete" icon="sap-icon://delete" type="Transparent" press=".onDeleteRule" />
            <ToolbarSeparator />
            <Button text="Export to Excel" icon="sap-icon://excel-attachment" type="Transparent" press=".onExportExcel" />
            <Button text="Import from Excel" icon="sap-icon://upload" type="Transparent" press=".onImportExcel" />
            <ToolbarSeparator />
            <Button text="Save" icon="sap-icon://save" type="Emphasized" press=".onSave" enabled="{view>/dirty}" />
            <Button text="Discard" icon="sap-icon://undo" type="Transparent" press=".onDiscard" enabled="{view>/dirty}" />
          </OverflowToolbar>
        </headerToolbar>
        <columns>
          <Column width="15%"><Text text="Condition 1 Field" /></Column>
          <Column width="10%"><Text text="Condition 1 Value" /></Column>
          <!-- Titleless on purpose: AND / OR / NOR reads as the joining word between the two
               conditions it sits between, and a heading would only repeat what the cell says. -->
          <Column width="5%" hAlign="Center"><Text text="" /></Column>
          <Column width="15%"><Text text="Condition 2 Field" /></Column>
          <Column width="10%"><Text text="Condition 2 Value" /></Column>
          <Column width="20%"><Text text="Field" /></Column>
          <Column width="20%"><Text text="Value" /></Column>
          <Column width="4rem" hAlign="Center"><Text text="Active" /></Column>
        </columns>
        <items>
          <ColumnListItem>
            <cells>
              <Input
                width="100%"
                value="{dc>conditionField}"
                placeholder="any"
                showValueHelp="true"
                valueHelpRequest=".onFieldValueHelp"
                change=".onCellChange" />
              <Input
                width="100%"
                value="{dc>conditionValue}"
                placeholder="any"
                enabled="{= !!${dc>conditionField} }"
                change=".onCellChange" />
              <!-- Only enabled once BOTH conditions are filled: there is nothing to join otherwise,
                   and NOR on a single condition would silently invert it. -->
              <ComboBox
                width="100%"
                selectedKey="{dc>conditionLogic}"
                enabled="{= !!${dc>conditionField} &amp;&amp; !!${dc>conditionField2} }"
                items="{ path: 'opt>/conditionLogics', templateShareable: false }"
                change=".onCellChange">
                <core:Item key="{opt>code}" text="{opt>text}" />
              </ComboBox>
              <Input
                width="100%"
                value="{dc>conditionField2}"
                placeholder="any"
                showValueHelp="true"
                valueHelpRequest=".onFieldValueHelp"
                change=".onCellChange" />
              <Input
                width="100%"
                value="{dc>conditionValue2}"
                placeholder="any"
                enabled="{= !!${dc>conditionField2} }"
                change=".onCellChange" />
              <!-- The field being filled in. -->
              <Input
                width="100%"
                value="{dc>field}"
                placeholder="choose a field"
                showValueHelp="true"
                valueHelpRequest=".onFieldValueHelp"
                change=".onCellChange" />
              <!-- Free text or a field. The value help is here precisely so "same value as field B"
                   is a pick rather than something a steward has to spell exactly. -->
              <VBox>
                <Input
                  width="100%"
                  value="{dc>value}"
                  placeholder="value or field"
                  showValueHelp="true"
                  valueHelpRequest=".onFieldValueHelp"
                  change=".onCellChange" />
                <Text
                  class="sapUiTinyMarginTop"
                  visible="{ parts: [{ path: 'dc>value' }, { path: 'view>/fieldText' }], formatter: '.isFieldReference' }"
                  text="{ parts: [{ path: 'dc>value' }, { path: 'view>/fieldText' }], formatter: '.formatValueHint' }"
                  wrapping="true" />
              </VBox>
              <CheckBox selected="{dc>isActive}" select=".onCellChange" />
            </cells>
          </ColumnListItem>
        </items>
      </Table>
    </content>
  </Page>
</mvc:View>
