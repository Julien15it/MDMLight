<mvc:View
  controllerName="mdm.md.mdmrules.manage.ext.controller.DerivationRuleList"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns:core="sap.ui.core"
  xmlns="sap.m"
  height="100%">
  <Page
    title="Derivation Rules"
    showNavButton="true"
    navButtonPress=".onBackToHub">
    <content>
      <!--
        Same decision-table shape as the validation and duplicate rule tables. Read a row as one
        sentence: "where Country is BE, fill Language with NL".
      -->
      <MessageStrip
        class="sapUiSmallMarginBeginEnd sapUiSmallMarginTop"
        visible="{= ${view>/skipped} > 0 }"
        text="{view>/skippedText}"
        type="Warning"
        showIcon="true" />
      <!-- Stated once here rather than per row, because it is the one thing about this table that
           is not obvious from its columns. -->
      <MessageStrip
        class="sapUiSmallMarginBeginEnd sapUiSmallMarginTop"
        text="A derivation only ever fills an empty field — it never overwrites what a requester typed — and it is proposed to them rather than applied silently. In the Value column, a plain value is written as text, while a value that names a field (Country (Address)) copies that field instead."
        type="Information"
        showIcon="true" />
      <Table
        id="ruleTable"
        items="{ path: 'dc>/DerivationRules', parameters: { $orderby: 'sequence,createdAt', $$updateGroupId: 'ruleChanges' } }"
        mode="SingleSelectMaster"
        busy="{view>/busy}"
        growing="true"
        growingThreshold="100">
        <headerToolbar>
          <OverflowToolbar>
            <Title text="Rules" level="H2" />
            <ToolbarSpacer />
            <Button text="Add Rule" icon="sap-icon://add" type="Transparent" press=".onAddRule" />
            <Button text="Delete" icon="sap-icon://delete" type="Transparent" press=".onDeleteRule" />
            <Button text="Save" icon="sap-icon://save" type="Emphasized" press=".onSave" enabled="{view>/dirty}" />
            <Button text="Discard" icon="sap-icon://undo" type="Transparent" press=".onDiscard" enabled="{view>/dirty}" />
          </OverflowToolbar>
        </headerToolbar>
        <columns>
          <Column width="16%"><Text text="Condition 1 Field" /></Column>
          <Column width="11%"><Text text="Condition 1 Value" /></Column>
          <Column width="16%"><Text text="Condition 2 Field" /></Column>
          <Column width="11%"><Text text="Condition 2 Value" /></Column>
          <Column width="20%"><Text text="Field" /></Column>
          <Column width="20%"><Text text="Value" /></Column>
          <Column width="4rem" hAlign="Center"><Text text="Active" /></Column>
        </columns>
        <items>
          <ColumnListItem>
            <cells>
              <Input
                width="100%"
                value="{dc>conditionField}"
                placeholder="any"
                showValueHelp="true"
                valueHelpRequest=".onFieldValueHelp"
                change=".onCellChange" />
              <Input
                width="100%"
                value="{dc>conditionValue}"
                placeholder="any"
                enabled="{= !!${dc>conditionField} }"
                change=".onCellChange" />
              <Input
                width="100%"
                value="{dc>conditionField2}"
                placeholder="any"
                showValueHelp="true"
                valueHelpRequest=".onFieldValueHelp"
                change=".onCellChange" />
              <Input
                width="100%"
                value="{dc>conditionValue2}"
                placeholder="any"
                enabled="{= !!${dc>conditionField2} }"
                change=".onCellChange" />
              <!-- The field being filled in. -->
              <Input
                width="100%"
                value="{dc>field}"
                placeholder="choose a field"
                showValueHelp="true"
                valueHelpRequest=".onFieldValueHelp"
                change=".onCellChange" />
              <!-- Free text or a field. The value help is here precisely so "same value as field B"
                   is a pick rather than something a steward has to spell exactly. -->
              <VBox>
                <Input
                  width="100%"
                  value="{dc>value}"
                  placeholder="value or field"
                  showValueHelp="true"
                  valueHelpRequest=".onFieldValueHelp"
                  change=".onCellChange" />
                <Text
                  class="sapUiTinyMarginTop"
                  visible="{= !!${view>/fieldText}[${dc>value}] }"
                  text="{= 'Copied from ' + ${view>/fieldText}[${dc>value}] }"
                  wrapping="true" />
              </VBox>
              <CheckBox selected="{dc>isActive}" select=".onCellChange" />
            </cells>
          </ColumnListItem>
        </items>
      </Table>
    </content>
  </Page>
</mvc:View>
