<mvc:View
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:uxap="sap.uxap"
  controllerName="mdm.md.businesspartner.reuse.controller.BusinessPartnerMaintenance"
  displayBlock="true">
  <Page
    id="maintenancePage"
    showHeader="false"
    busy="{maintenance>/busy}">
    <content>
      <!-- Message area, MDG-style: the result of a submit is reported here and the request header
           stays on screen, rather than the user being returned to the list with a toast. Duplicate
           findings land here, and so will any future validation. -->
      <!-- Collapsible, like the duplicate findings below: a submit reports several strips and an
           information-only set must not push the form off screen. The header carries the leading
           message, so a collapsed panel still says what it holds, and anything above Information
           opens the panel itself rather than making somebody click for it. -->
      <Panel
        id="maintenanceMessagePanel"
        class="sapUiSmallMarginBeginEnd sapUiSmallMarginTop"
        expandable="true"
        expanded="{ path: 'maintenance>/messages', formatter: '.messagesNeedAttention' }"
        visible="{= ${maintenance>/messages}.length > 0 }"
        headerText="{ path: 'maintenance>/messages', formatter: '.messagesHeader' }">
        <VBox
          id="maintenanceMessages"
          items="{ path: 'maintenance>/messages', templateShareable: false }">
          <MessageStrip
            text="{maintenance>text}"
            type="{maintenance>type}"
            showIcon="true"
            showCloseButton="false"
            class="sapUiTinyMarginBottom" />
        </VBox>
      </Panel>
      <!-- The requester/approver conversation, oldest first. Collapsible like the duplicate findings
           below - a rework loop can run several rounds, and a closed panel still says how many
           messages it holds. rejectionComment/reason only ever held the latest side's word; this is
           the full thread behind it, from getRequestPayload's CommentsJson via _setCommentsPanel. -->
      <Panel
        id="commentsPanel"
        class="sapUiSmallMarginBeginEnd sapUiSmallMarginTop"
        expandable="true"
        expanded="true"
        visible="{= ${maintenance>/comments}.length > 0 }"
        headerText="{maintenance>/commentsHeader}">
        <List items="{ path: 'maintenance>/comments', templateShareable: false }">
          <StandardListItem
            title="{maintenance>title}"
            description="{maintenance>text}"
            info="{maintenance>date}"
            infoState="None"
            wrapping="true" />
        </List>
      </Panel>
      <!-- The approver's note to the requester, sent back only if rejected - see
           _decideOnServer in app/bptask's Component.js, which already reads context>/comment
           for decideRequest's Comment. `context` is a model only app/bptask's Component sets,
           so this is embedded-only; a standalone approve (dev testing only, per CLAUDE.md) has
           no comment path either way. Approve mode only - a rework/edit screen has nothing to
           decide yet. Kept near the top, beside the message panel, rather than at the bottom of
           the content: My Inbox does not reliably give an embedded app's own lower content room
           either (confirmed 2026-08-24 - it rendered, cut off below the visible area), the same
           lesson the footer buttons already taught. -->
      <VBox
        id="approverCommentBox"
        class="sapUiSmallMarginBeginEnd sapUiSmallMarginTop"
        visible="{= ${env>/embedded} &amp;&amp; ${maintenance>/mode} === 'approve' }">
        <Label text="Comment for the requester (sent back if rejected)" labelFor="approverCommentInput" />
        <TextArea id="approverCommentInput" width="100%" rows="2" value="{context>/comment}" />
      </VBox>
      <!-- The requester's note for this round, appended to the same thread on Resubmit - see
           _sendChangeRequest, which sends it as resubmitRequest's Reason. Unlike the approver's box
           above this is NOT embedded-only: rework is reached standalone too, by the reworkurl deep
           link SPA sends on a rejection (see CLAUDE.md, "Rework"), and context>/comment does not
           exist there. Rework mode only - nothing to say yet on a draft or a fresh create. -->
      <VBox
        id="reworkCommentBox"
        class="sapUiSmallMarginBeginEnd sapUiSmallMarginTop"
        visible="{= ${maintenance>/mode} === 'rework' }">
        <Label text="Note for the approver (optional)" labelFor="reworkCommentInput" />
        <TextArea id="reworkCommentInput" width="100%" rows="2" value="{maintenance>/reworkComment}" />
      </VBox>
      <!-- One section that failed to load, or had nothing to resolve its Customer/Supplier
           relation to, must never be silent - a blank section otherwise looks identical to
           "this Business Partner genuinely has no data here". -->
      <VBox
        id="maintenanceSectionWarnings"
        class="sapUiSmallMarginBeginEnd sapUiSmallMarginTop"
        visible="{= ${maintenance>/sectionWarnings}.length > 0 }"
        items="{ path: 'maintenance>/sectionWarnings', templateShareable: false }">
        <MessageStrip
          text="{maintenance>text}"
          type="Warning"
          showIcon="true"
          showCloseButton="false"
          class="sapUiTinyMarginBottom" />
      </VBox>
      <!-- The findings stay after the dialog is dismissed. Collapsed and scrolling inside itself,
           so twenty near-matches cannot push the form off screen. -->
      <Panel
        id="duplicateFindings"
        class="sapUiSmallMarginBeginEnd sapUiSmallMarginTop"
        expandable="true"
        expanded="false"
        visible="{= ${maintenance>/duplicates}.length > 0 }"
        headerText="{maintenance>/duplicatesHeader}">
        <MessageStrip
          text="Nothing is blocked. Review these before submitting."
          type="Warning"
          showIcon="true"
          class="sapUiTinyMarginBottom" />
        <ScrollContainer height="14rem" vertical="true" horizontal="false" focusable="true">
          <List items="{ path: 'maintenance>/duplicates', templateShareable: false }">
            <StandardListItem
              title="{maintenance>title}"
              description="{maintenance>description}"
              info="{maintenance>verdict}"
              infoState="Warning"
              wrapping="true" />
          </List>
        </ScrollContainer>
      </Panel>
      <uxap:ObjectPageLayout
        id="maintenanceObjectPage"
        showAnchorBar="true"
        upperCaseAnchorBar="false"
        useIconTabBar="false"
        showHeaderContent="false"
        enableLazyLoading="false">
        <uxap:headerTitle>
          <uxap:ObjectPageDynamicHeaderTitle>
            <uxap:expandedHeading>
              <VBox>
                <Title text="{maintenance>/headerTitle}" level="H1" wrapping="true" />
                <ObjectNumber number="{maintenance>/businessPartner}" />
                <HBox alignItems="Center" visible="{= !!${maintenance>/changeRequest} }">
                  <Label text="Change Request" />
                  <Text
                    text="{maintenance>/changeRequest}"
                    class="sapUiTinyMarginBegin"
                    wrapping="false" />
                  <ObjectStatus
                    text="{maintenance>/requestStatus}"
                    state="{= ${maintenance>/requestStatus} === 'rejected' || ${maintenance>/requestStatus} === 'failed' ? 'Error' : ${maintenance>/requestStatus} === 'posted' ? 'Success' : 'Warning' }"
                    class="sapUiSmallMarginBegin" />
                </HBox>
              </VBox>
            </uxap:expandedHeading>
            <uxap:snappedHeading>
              <HBox alignItems="Center">
                <Title text="{maintenance>/headerTitle}" level="H2" />
                <ObjectNumber number="{maintenance>/businessPartner}" class="sapUiSmallMarginBegin" />
                <Text
                  text="{maintenance>/changeRequest}"
                  visible="{= !!${maintenance>/changeRequest} }"
                  class="sapUiSmallMarginBegin"
                  wrapping="false" />
              </HBox>
            </uxap:snappedHeading>
            <uxap:actions>
              <Button
                text="Business Partners"
                icon="sap-icon://nav-back"
                type="Transparent"
                visible="{= !${env>/embedded} }"
                press=".onBackToList" />
              <!-- Check/Duplicate Check as header actions, pressing the identical handlers as the
                   footer. Embedded, the Page's footer is not rendered by the inbox chrome at all -
                   which took Check, Duplicate Check, Resubmit, Withdraw and Back with it, and left
                   only the Approve/Reject that come from inboxAPI.addAction. The header actions are
                   page content, so they do render. (Not the bottom of the content either: the
                   approver comment box was cut off below the visible area down there.)

                   Check and Duplicate Check are here regardless of env>/embedded, on Maarten's ask
                   (2026-08-24): on a long create form the footer is a scroll away from the fields
                   somebody is filling in, and the two questions they answer - is this right, does it
                   already exist - get asked while typing. The footer's own copies of these two are
                   gone, not merely hidden standalone: they were in both places for an hour, which
                   just showed them twice.

                   Resubmit and Withdraw are NOT header actions (reverted 2026-08-24, after a brief
                   detour through here): both ARE declared outcomes (sap.bpa.task.outcomes), so they
                   go through inboxAPI.addAction instead, in _addReworkInboxActions - the same native
                   action-bar location Approve/Reject already render in, rather than a second,
                   differently-styled button up here. The footer's own Resubmit/Withdraw stay
                   embedded-only, unlike Check/Duplicate Check: one is the primary action and belongs
                   in the footer where Fiori puts it, and the other destroys the request. -->
              <Button
                text="Check"
                icon="sap-icon://validate"
                type="Transparent"
                visible="{maintenance>/showCheckButton}"
                press=".onCheck" />
              <Button
                text="Duplicate Check"
                icon="sap-icon://duplicate"
                type="Transparent"
                visible="{maintenance>/showCheckButton}"
                press=".onDuplicateCheck" />
              <!-- Gone, not degraded, when a steward has switched AI assistance off: an
                   installation that may not use AI should not be offered it. The server
                   refuses the action too - see srv/business-partner-service.js. -->
              <Button
                text="Ask Assistant"
                icon="sap-icon://discussion-2"
                type="Transparent"
                visible="{perm>/aiAssistanceEnabled}"
                press=".onOpenAssistant" />
              <Button
                text="Edit Business Partner"
                icon="sap-icon://edit"
                type="Emphasized"
                visible="{maintenance>/showEditButton}"
                press=".onEdit" />
            </uxap:actions>
          </uxap:ObjectPageDynamicHeaderTitle>
        </uxap:headerTitle>
        <uxap:sections>
          <uxap:ObjectPageSection title="General Information" titleUppercase="false">
            <uxap:subSections>
              <uxap:ObjectPageSubSection>
                <uxap:blocks>
                  <VBox id="GeneralInformationContent" width="100%" />
                </uxap:blocks>
              </uxap:ObjectPageSubSection>
            </uxap:subSections>
          </uxap:ObjectPageSection>
          <uxap:ObjectPageSection title="Names" titleUppercase="false">
            <uxap:subSections>
              <uxap:ObjectPageSubSection>
                <uxap:blocks>
                  <VBox id="NamesContent" width="100%" />
                </uxap:blocks>
              </uxap:ObjectPageSubSection>
            </uxap:subSections>
          </uxap:ObjectPageSection>
          <uxap:ObjectPageSection title="Addresses" titleUppercase="false">
            <uxap:subSections>
              <uxap:ObjectPageSubSection>
                <uxap:blocks>
                  <VBox id="AddressesContent" width="100%" />
                </uxap:blocks>
              </uxap:ObjectPageSubSection>
            </uxap:subSections>
          </uxap:ObjectPageSection>
          <uxap:ObjectPageSection title="Roles" titleUppercase="false">
            <uxap:subSections>
              <uxap:ObjectPageSubSection>
                <uxap:blocks>
                  <VBox id="BusinessPartnerRolesContent" width="100%" />
                </uxap:blocks>
              </uxap:ObjectPageSubSection>
            </uxap:subSections>
          </uxap:ObjectPageSection>
          <uxap:ObjectPageSection title="Tax Numbers" titleUppercase="false">
            <uxap:subSections>
              <uxap:ObjectPageSubSection>
                <uxap:blocks>
                  <VBox id="TaxNumbersContent" width="100%" />
                </uxap:blocks>
              </uxap:ObjectPageSubSection>
            </uxap:subSections>
          </uxap:ObjectPageSection>
          <uxap:ObjectPageSection title="Bank Details" titleUppercase="false">
            <uxap:subSections>
              <uxap:ObjectPageSubSection>
                <uxap:blocks>
                  <VBox id="BankDetailsContent" width="100%" />
                </uxap:blocks>
              </uxap:ObjectPageSubSection>
            </uxap:subSections>
          </uxap:ObjectPageSection>
          <uxap:ObjectPageSection title="Identification" titleUppercase="false">
            <uxap:subSections>
              <uxap:ObjectPageSubSection>
                <uxap:blocks>
                  <VBox id="IdentificationsContent" width="100%" />
                </uxap:blocks>
              </uxap:ObjectPageSubSection>
            </uxap:subSections>
          </uxap:ObjectPageSection>
          <uxap:ObjectPageSection title="Industries" titleUppercase="false">
            <uxap:subSections>
              <uxap:ObjectPageSubSection>
                <uxap:blocks>
                  <VBox id="IndustriesContent" width="100%" />
                </uxap:blocks>
              </uxap:ObjectPageSubSection>
            </uxap:subSections>
          </uxap:ObjectPageSection>
          <!-- One block per role. Company Codes, Sales Areas and Purchasing Organizations
               deliberately have no block of their own: they render inside the Details
               dialog of the customer/supplier they belong to (childSections in
               BusinessPartnerMetadata), as the standard MDG ERP Customer screen does. -->
          <uxap:ObjectPageSection title="Customer Data" titleUppercase="false">
            <uxap:subSections>
              <uxap:ObjectPageSubSection>
                <uxap:blocks>
                  <VBox id="CustomersContent" width="100%" />
                </uxap:blocks>
              </uxap:ObjectPageSubSection>
            </uxap:subSections>
          </uxap:ObjectPageSection>
          <uxap:ObjectPageSection title="Supplier Data" titleUppercase="false">
            <uxap:subSections>
              <uxap:ObjectPageSubSection>
                <uxap:blocks>
                  <VBox id="SuppliersContent" width="100%" />
                </uxap:blocks>
              </uxap:ObjectPageSubSection>
            </uxap:subSections>
          </uxap:ObjectPageSection>
        </uxap:sections>
      </uxap:ObjectPageLayout>
    </content>
    <footer>
      <OverflowToolbar visible="{maintenance>/showFooter}">
        <ToolbarSpacer />
        <!-- Two questions, two buttons: is this record right, and does it already exist? Submit runs
             the duplicate check anyway, so neither is a gate. They live in the HEADER actions, not
             here: on a long form the footer is a scroll away from the fields being filled in, and
             they were briefly in both places, which just showed them twice. -->
        <Button
          text="Save Request"
          icon="sap-icon://save"
          visible="{maintenance>/showSaveRequestButton}"
          press=".onSaveRequest" />
        <!-- In rework mode this is "Resubmit" (see saveButtonText). Hidden embedded like
             Approve/Reject below: My Inbox does not reliably give an app's own footer room
             (confirmed 2026-08-21, the button simply did not render), so the task app's inbox
             actions ask for this same onSave flow over the event bus instead - see
             _addReworkInboxActions in app/bptask's Component.js. Create/edit modes never run
             embedded, so this guard only ever bites in rework. -->
        <Button
          text="{maintenance>/saveButtonText}"
          type="Emphasized"
          visible="{= ${maintenance>/showSaveButton} &amp;&amp; !${env>/embedded} }"
          press=".onSave" />
        <!-- Rework's second button. Withdraw is the only action on this screen that destroys
             data, hence Reject styling and a confirm. Hidden embedded for the same reason as
             the button above. -->
        <Button
          text="Withdraw"
          icon="sap-icon://delete"
          type="Reject"
          visible="{= ${maintenance>/showReworkButtons} &amp;&amp; !${env>/embedded} }"
          press=".onWithdraw" />
        <Button
          text="Approve"
          icon="sap-icon://accept"
          type="Accept"
          visible="{= ${maintenance>/showDecisionButtons} &amp;&amp; !${env>/embedded} }"
          press=".onApprove" />
        <Button
          text="Reject"
          icon="sap-icon://decline"
          type="Reject"
          visible="{= ${maintenance>/showDecisionButtons} &amp;&amp; !${env>/embedded} }"
          press=".onReject" />
        <Button
          text="{maintenance>/cancelButtonText}"
          visible="{maintenance>/showCancelButton}"
          press=".onCancel" />
      </OverflowToolbar>
    </footer>
  </Page>
</mvc:View>
