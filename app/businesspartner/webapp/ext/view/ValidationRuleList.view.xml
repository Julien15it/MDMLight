<mvc:View
  controllerName="mdm.md.businesspartner.manage.ext.controller.ValidationRuleList"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns:core="sap.ui.core"
  xmlns="sap.m"
  height="100%">
  <Page
    title="Validation Rules"
    showNavButton="true"
    navButtonPress=".onBackToHub">
    <content>
      <!-- The layout is the duplicate rule table's, deliberately: the shape of a rule is the part
           we are agreeing on here. Nothing is stored or executed yet, and saying so is the whole
           point of this strip - a table that looks live and silently does nothing is worse than
           no table at all. -->
      <MessageStrip
        class="sapUiSmallMarginBeginEnd sapUiSmallMarginTop"
        text="Preview only. Validation rules are not stored or executed yet — VIES and GLEIF are still the only validations that run, and they are wired in code (srv/checks/registry-checks.js)."
        type="Warning"
        showIcon="true" />
      <Table
        id="ruleTable"
        items="{ path: 'rules>/rules' }"
        mode="SingleSelectMaster"
        growing="true"
        growingThreshold="100">
        <headerToolbar>
          <OverflowToolbar>
            <Title text="Rules" level="H2" />
            <ToolbarSpacer />
            <Button text="Add Rule" icon="sap-icon://add" type="Transparent" press=".onAddRule" />
            <Button text="Delete" icon="sap-icon://delete" type="Transparent" press=".onDeleteRule" />
            <Button text="Save" icon="sap-icon://save" type="Emphasized" enabled="false" tooltip="Not implemented yet" />
          </OverflowToolbar>
        </headerToolbar>
        <columns>
          <Column width="12%"><Text text="Condition 1 Field" /></Column>
          <Column width="10%"><Text text="Condition 1 Value" /></Column>
          <Column width="12%"><Text text="Condition 2 Field" /></Column>
          <Column width="10%"><Text text="Condition 2 Value" /></Column>
          <Column width="18%"><Text text="Field" /></Column>
          <Column width="17%"><Text text="Rule" /></Column>
          <Column width="17%"><Text text="Severity" /></Column>
          <Column width="4rem" hAlign="Center"><Text text="Active" /></Column>
        </columns>
        <items>
          <ColumnListItem>
            <cells>
              <ComboBox
                width="100%"
                selectedKey="{rules>conditionField}"
                placeholder="any"
                items="{ path: 'opt>/fields', templateShareable: false }">
                <core:Item key="{opt>code}" text="{opt>text}" />
              </ComboBox>
              <Input width="100%" value="{rules>conditionValue}" placeholder="any" />
              <ComboBox
                width="100%"
                selectedKey="{rules>conditionField2}"
                placeholder="any"
                items="{ path: 'opt>/fields', templateShareable: false }">
                <core:Item key="{opt>code}" text="{opt>text}" />
              </ComboBox>
              <Input width="100%" value="{rules>conditionValue2}" placeholder="any" />
              <ComboBox
                width="100%"
                selectedKey="{rules>field}"
                items="{ path: 'opt>/fields', templateShareable: false }">
                <core:Item key="{opt>code}" text="{opt>text}" />
              </ComboBox>
              <ComboBox
                width="100%"
                selectedKey="{rules>check}"
                items="{ path: 'opt>/checks', templateShareable: false }">
                <core:Item key="{opt>code}" text="{opt>text}" />
              </ComboBox>
              <ComboBox
                width="100%"
                selectedKey="{rules>severity}"
                items="{ path: 'opt>/severities', templateShareable: false }">
                <core:Item key="{opt>code}" text="{opt>text}" />
              </ComboBox>
              <CheckBox selected="{rules>isActive}" />
            </cells>
          </ColumnListItem>
        </items>
      </Table>
    </content>
  </Page>
</mvc:View>
