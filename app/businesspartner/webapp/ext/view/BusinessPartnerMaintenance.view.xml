<mvc:View
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:uxap="sap.uxap"
  controllerName="mdm.md.businesspartner.manage.ext.controller.BusinessPartnerMaintenance"
  displayBlock="true">
  <Page
    id="maintenancePage"
    showHeader="false"
    busy="{maintenance>/busy}">
    <content>
      <uxap:ObjectPageLayout
        id="maintenanceObjectPage"
        showAnchorBar="true"
        upperCaseAnchorBar="false"
        useIconTabBar="false"
        showHeaderContent="false"
        enableLazyLoading="false">
        <uxap:headerTitle>
          <uxap:ObjectPageDynamicHeaderTitle>
            <uxap:expandedHeading>
              <VBox>
                <Title text="{maintenance>/headerTitle}" level="H1" wrapping="true" />
                <ObjectNumber number="{maintenance>/businessPartner}" />
                <HBox alignItems="Center" visible="{= !!${maintenance>/changeRequest} }">
                  <Label text="Change Request" />
                  <Text
                    text="{maintenance>/changeRequest}"
                    class="sapUiTinyMarginBegin"
                    wrapping="false" />
                  <ObjectStatus
                    text="{maintenance>/requestStatus}"
                    state="{= ${maintenance>/requestStatus} === 'rejected' || ${maintenance>/requestStatus} === 'failed' ? 'Error' : ${maintenance>/requestStatus} === 'posted' ? 'Success' : 'Warning' }"
                    class="sapUiSmallMarginBegin" />
                </HBox>
              </VBox>
            </uxap:expandedHeading>
            <uxap:snappedHeading>
              <HBox alignItems="Center">
                <Title text="{maintenance>/headerTitle}" level="H2" />
                <ObjectNumber number="{maintenance>/businessPartner}" class="sapUiSmallMarginBegin" />
                <Text
                  text="{maintenance>/changeRequest}"
                  visible="{= !!${maintenance>/changeRequest} }"
                  class="sapUiSmallMarginBegin"
                  wrapping="false" />
              </HBox>
            </uxap:snappedHeading>
            <uxap:actions>
              <Button
                text="Business Partners"
                icon="sap-icon://nav-back"
                type="Transparent"
                press=".onBackToList" />
              <Button
                text="Ask Assistant"
                icon="sap-icon://discussion-2"
                type="Transparent"
                press=".onOpenAssistant" />
              <Button
                text="Edit Business Partner"
                icon="sap-icon://edit"
                type="Emphasized"
                visible="{maintenance>/showEditButton}"
                press=".onEdit" />
            </uxap:actions>
          </uxap:ObjectPageDynamicHeaderTitle>
        </uxap:headerTitle>
        <uxap:sections>
          <uxap:ObjectPageSection title="General Information" titleUppercase="false">
            <uxap:subSections>
              <uxap:ObjectPageSubSection>
                <uxap:blocks>
                  <VBox id="GeneralInformationContent" width="100%" />
                </uxap:blocks>
              </uxap:ObjectPageSubSection>
            </uxap:subSections>
          </uxap:ObjectPageSection>
          <uxap:ObjectPageSection title="Names" titleUppercase="false">
            <uxap:subSections>
              <uxap:ObjectPageSubSection>
                <uxap:blocks>
                  <VBox id="NamesContent" width="100%" />
                </uxap:blocks>
              </uxap:ObjectPageSubSection>
            </uxap:subSections>
          </uxap:ObjectPageSection>
          <uxap:ObjectPageSection title="Addresses" titleUppercase="false">
            <uxap:subSections>
              <uxap:ObjectPageSubSection>
                <uxap:blocks>
                  <VBox id="AddressesContent" width="100%" />
                </uxap:blocks>
              </uxap:ObjectPageSubSection>
            </uxap:subSections>
          </uxap:ObjectPageSection>
          <uxap:ObjectPageSection title="Roles" titleUppercase="false">
            <uxap:subSections>
              <uxap:ObjectPageSubSection>
                <uxap:blocks>
                  <VBox id="BusinessPartnerRolesContent" width="100%" />
                </uxap:blocks>
              </uxap:ObjectPageSubSection>
            </uxap:subSections>
          </uxap:ObjectPageSection>
          <uxap:ObjectPageSection title="Tax Numbers" titleUppercase="false">
            <uxap:subSections>
              <uxap:ObjectPageSubSection>
                <uxap:blocks>
                  <VBox id="TaxNumbersContent" width="100%" />
                </uxap:blocks>
              </uxap:ObjectPageSubSection>
            </uxap:subSections>
          </uxap:ObjectPageSection>
          <uxap:ObjectPageSection title="Bank Details" titleUppercase="false">
            <uxap:subSections>
              <uxap:ObjectPageSubSection>
                <uxap:blocks>
                  <VBox id="BankDetailsContent" width="100%" />
                </uxap:blocks>
              </uxap:ObjectPageSubSection>
            </uxap:subSections>
          </uxap:ObjectPageSection>
          <uxap:ObjectPageSection title="Identification" titleUppercase="false">
            <uxap:subSections>
              <uxap:ObjectPageSubSection>
                <uxap:blocks>
                  <VBox id="IdentificationsContent" width="100%" />
                </uxap:blocks>
              </uxap:ObjectPageSubSection>
            </uxap:subSections>
          </uxap:ObjectPageSection>
          <uxap:ObjectPageSection title="Industries" titleUppercase="false">
            <uxap:subSections>
              <uxap:ObjectPageSubSection>
                <uxap:blocks>
                  <VBox id="IndustriesContent" width="100%" />
                </uxap:blocks>
              </uxap:ObjectPageSubSection>
            </uxap:subSections>
          </uxap:ObjectPageSection>
          <uxap:ObjectPageSection title="Customer Data" titleUppercase="false">
            <uxap:subSections>
              <uxap:ObjectPageSubSection>
                <uxap:blocks>
                  <VBox id="CustomersContent" width="100%" />
                </uxap:blocks>
              </uxap:ObjectPageSubSection>
            </uxap:subSections>
          </uxap:ObjectPageSection>
          <uxap:ObjectPageSection title="Supplier Data" titleUppercase="false">
            <uxap:subSections>
              <uxap:ObjectPageSubSection>
                <uxap:blocks>
                  <VBox id="SuppliersContent" width="100%" />
                </uxap:blocks>
              </uxap:ObjectPageSubSection>
            </uxap:subSections>
          </uxap:ObjectPageSection>
        </uxap:sections>
      </uxap:ObjectPageLayout>
    </content>
    <footer>
      <OverflowToolbar visible="{maintenance>/showFooter}">
        <ToolbarSpacer />
        <Button
          text="Preview"
          icon="sap-icon://show"
          type="Emphasized"
          visible="{maintenance>/showPreviewButton}"
          press=".onPreview" />
        <Button
          text="Save Request"
          icon="sap-icon://save"
          visible="{maintenance>/showSaveRequestButton}"
          press=".onSaveRequest" />
        <Button
          text="{maintenance>/saveButtonText}"
          type="Emphasized"
          visible="{maintenance>/showSaveButton}"
          press=".onSave" />
        <Button
          text="Approve"
          icon="sap-icon://accept"
          type="Accept"
          visible="{maintenance>/showDecisionButtons}"
          press=".onApprove" />
        <Button
          text="Reject"
          icon="sap-icon://decline"
          type="Reject"
          visible="{maintenance>/showDecisionButtons}"
          press=".onReject" />
        <Button text="{maintenance>/cancelButtonText}" press=".onCancel" />
      </OverflowToolbar>
    </footer>
  </Page>
</mvc:View>
