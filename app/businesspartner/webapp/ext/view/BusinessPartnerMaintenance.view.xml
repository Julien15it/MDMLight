<mvc:View
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:uxap="sap.uxap"
  controllerName="mdm.md.businesspartner.manage.ext.controller.BusinessPartnerMaintenance"
  displayBlock="true">
  <Page
    id="maintenancePage"
    showHeader="false"
    busy="{maintenance>/busy}">
    <content>
      <!-- Message area, MDG-style: the result of a submit is reported here and the request header
           stays on screen, rather than the user being returned to the list with a toast. Duplicate
           findings land here, and so will any future validation. -->
      <VBox
        id="maintenanceMessages"
        class="sapUiSmallMarginBeginEnd sapUiSmallMarginTop"
        visible="{= ${maintenance>/messages}.length > 0 }"
        items="{ path: 'maintenance>/messages', templateShareable: false }">
        <MessageStrip
          text="{maintenance>text}"
          type="{maintenance>type}"
          showIcon="true"
          showCloseButton="false"
          class="sapUiTinyMarginBottom" />
      </VBox>
      <!-- One section that failed to load, or had nothing to resolve its Customer/Supplier
           relation to, must never be silent - a blank section otherwise looks identical to
           "this Business Partner genuinely has no data here". -->
      <VBox
        id="maintenanceSectionWarnings"
        class="sapUiSmallMarginBeginEnd sapUiSmallMarginTop"
        visible="{= ${maintenance>/sectionWarnings}.length > 0 }"
        items="{ path: 'maintenance>/sectionWarnings', templateShareable: false }">
        <MessageStrip
          text="{maintenance>text}"
          type="Warning"
          showIcon="true"
          showCloseButton="false"
          class="sapUiTinyMarginBottom" />
      </VBox>
      <!-- The findings stay after the dialog is dismissed. Collapsed and scrolling inside itself,
           so twenty near-matches cannot push the form off screen. -->
      <Panel
        id="duplicateFindings"
        class="sapUiSmallMarginBeginEnd sapUiSmallMarginTop"
        expandable="true"
        expanded="false"
        visible="{= ${maintenance>/duplicates}.length > 0 }"
        headerText="{maintenance>/duplicatesHeader}">
        <MessageStrip
          text="Nothing is blocked. Review these before submitting."
          type="Warning"
          showIcon="true"
          class="sapUiTinyMarginBottom" />
        <ScrollContainer height="14rem" vertical="true" horizontal="false" focusable="true">
          <List items="{ path: 'maintenance>/duplicates', templateShareable: false }">
            <StandardListItem
              title="{maintenance>title}"
              description="{maintenance>description}"
              info="{maintenance>verdict}"
              infoState="Warning"
              wrapping="true" />
          </List>
        </ScrollContainer>
      </Panel>
      <uxap:ObjectPageLayout
        id="maintenanceObjectPage"
        showAnchorBar="true"
        upperCaseAnchorBar="false"
        useIconTabBar="false"
        showHeaderContent="false"
        enableLazyLoading="false">
        <uxap:headerTitle>
          <uxap:ObjectPageDynamicHeaderTitle>
            <uxap:expandedHeading>
              <VBox>
                <Title text="{maintenance>/headerTitle}" level="H1" wrapping="true" />
                <ObjectNumber number="{maintenance>/businessPartner}" />
                <HBox alignItems="Center" visible="{= !!${maintenance>/changeRequest} }">
                  <Label text="Change Request" />
                  <Text
                    text="{maintenance>/changeRequest}"
                    class="sapUiTinyMarginBegin"
                    wrapping="false" />
                  <ObjectStatus
                    text="{maintenance>/requestStatus}"
                    state="{= ${maintenance>/requestStatus} === 'rejected' || ${maintenance>/requestStatus} === 'failed' ? 'Error' : ${maintenance>/requestStatus} === 'posted' ? 'Success' : 'Warning' }"
                    class="sapUiSmallMarginBegin" />
                </HBox>
              </VBox>
            </uxap:expandedHeading>
            <uxap:snappedHeading>
              <HBox alignItems="Center">
                <Title text="{maintenance>/headerTitle}" level="H2" />
                <ObjectNumber number="{maintenance>/businessPartner}" class="sapUiSmallMarginBegin" />
                <Text
                  text="{maintenance>/changeRequest}"
                  visible="{= !!${maintenance>/changeRequest} }"
                  class="sapUiSmallMarginBegin"
                  wrapping="false" />
              </HBox>
            </uxap:snappedHeading>
            <uxap:actions>
              <Button
                text="Business Partners"
                icon="sap-icon://nav-back"
                type="Transparent"
                visible="{= !${env>/embedded} }"
                press=".onBackToList" />
              <Button
                text="Ask Assistant"
                icon="sap-icon://discussion-2"
                type="Transparent"
                press=".onOpenAssistant" />
              <Button
                text="Edit Business Partner"
                icon="sap-icon://edit"
                type="Emphasized"
                visible="{maintenance>/showEditButton}"
                press=".onEdit" />
            </uxap:actions>
          </uxap:ObjectPageDynamicHeaderTitle>
        </uxap:headerTitle>
        <uxap:sections>
          <uxap:ObjectPageSection title="General Information" titleUppercase="false">
            <uxap:subSections>
              <uxap:ObjectPageSubSection>
                <uxap:blocks>
                  <VBox id="GeneralInformationContent" width="100%" />
                </uxap:blocks>
              </uxap:ObjectPageSubSection>
            </uxap:subSections>
          </uxap:ObjectPageSection>
          <uxap:ObjectPageSection title="Names" titleUppercase="false">
            <uxap:subSections>
              <uxap:ObjectPageSubSection>
                <uxap:blocks>
                  <VBox id="NamesContent" width="100%" />
                </uxap:blocks>
              </uxap:ObjectPageSubSection>
            </uxap:subSections>
          </uxap:ObjectPageSection>
          <uxap:ObjectPageSection title="Addresses" titleUppercase="false">
            <uxap:subSections>
              <uxap:ObjectPageSubSection>
                <uxap:blocks>
                  <VBox id="AddressesContent" width="100%" />
                </uxap:blocks>
              </uxap:ObjectPageSubSection>
            </uxap:subSections>
          </uxap:ObjectPageSection>
          <uxap:ObjectPageSection title="Roles" titleUppercase="false">
            <uxap:subSections>
              <uxap:ObjectPageSubSection>
                <uxap:blocks>
                  <VBox id="BusinessPartnerRolesContent" width="100%" />
                </uxap:blocks>
              </uxap:ObjectPageSubSection>
            </uxap:subSections>
          </uxap:ObjectPageSection>
          <uxap:ObjectPageSection title="Tax Numbers" titleUppercase="false">
            <uxap:subSections>
              <uxap:ObjectPageSubSection>
                <uxap:blocks>
                  <VBox id="TaxNumbersContent" width="100%" />
                </uxap:blocks>
              </uxap:ObjectPageSubSection>
            </uxap:subSections>
          </uxap:ObjectPageSection>
          <uxap:ObjectPageSection title="Bank Details" titleUppercase="false">
            <uxap:subSections>
              <uxap:ObjectPageSubSection>
                <uxap:blocks>
                  <VBox id="BankDetailsContent" width="100%" />
                </uxap:blocks>
              </uxap:ObjectPageSubSection>
            </uxap:subSections>
          </uxap:ObjectPageSection>
          <uxap:ObjectPageSection title="Identification" titleUppercase="false">
            <uxap:subSections>
              <uxap:ObjectPageSubSection>
                <uxap:blocks>
                  <VBox id="IdentificationsContent" width="100%" />
                </uxap:blocks>
              </uxap:ObjectPageSubSection>
            </uxap:subSections>
          </uxap:ObjectPageSection>
          <uxap:ObjectPageSection title="Industries" titleUppercase="false">
            <uxap:subSections>
              <uxap:ObjectPageSubSection>
                <uxap:blocks>
                  <VBox id="IndustriesContent" width="100%" />
                </uxap:blocks>
              </uxap:ObjectPageSubSection>
            </uxap:subSections>
          </uxap:ObjectPageSection>
          <uxap:ObjectPageSection title="Customer Data" titleUppercase="false">
            <uxap:subSections>
              <uxap:ObjectPageSubSection title="General">
                <uxap:blocks>
                  <VBox id="CustomersContent" width="100%" />
                </uxap:blocks>
              </uxap:ObjectPageSubSection>
              <uxap:ObjectPageSubSection title="Company Code Data">
                <uxap:blocks>
                  <VBox id="CustomerCompanyContent" width="100%" />
                </uxap:blocks>
              </uxap:ObjectPageSubSection>
              <uxap:ObjectPageSubSection title="Sales Area Data">
                <uxap:blocks>
                  <VBox id="CustomerSalesAreaContent" width="100%" />
                </uxap:blocks>
              </uxap:ObjectPageSubSection>
            </uxap:subSections>
          </uxap:ObjectPageSection>
          <uxap:ObjectPageSection title="Supplier Data" titleUppercase="false">
            <uxap:subSections>
              <uxap:ObjectPageSubSection title="General">
                <uxap:blocks>
                  <VBox id="SuppliersContent" width="100%" />
                </uxap:blocks>
              </uxap:ObjectPageSubSection>
              <uxap:ObjectPageSubSection title="Company Code Data">
                <uxap:blocks>
                  <VBox id="SupplierCompanyContent" width="100%" />
                </uxap:blocks>
              </uxap:ObjectPageSubSection>
              <uxap:ObjectPageSubSection title="Purchasing Organization Data">
                <uxap:blocks>
                  <VBox id="SupplierPurchasingOrgContent" width="100%" />
                </uxap:blocks>
              </uxap:ObjectPageSubSection>
            </uxap:subSections>
          </uxap:ObjectPageSection>
        </uxap:sections>
      </uxap:ObjectPageLayout>
    </content>
    <footer>
      <OverflowToolbar visible="{maintenance>/showFooter}">
        <ToolbarSpacer />
        <!-- Two questions, two buttons: is this record right, and does it already exist? Submit
             runs the duplicate check anyway, so neither is a gate. -->
        <Button
          text="Check"
          icon="sap-icon://validate"
          visible="{maintenance>/showCheckButton}"
          press=".onCheck" />
        <Button
          text="Duplicate Check"
          icon="sap-icon://duplicate"
          visible="{maintenance>/showCheckButton}"
          press=".onDuplicateCheck" />
        <Button
          text="Save Request"
          icon="sap-icon://save"
          visible="{maintenance>/showSaveRequestButton}"
          press=".onSaveRequest" />
        <Button
          text="{maintenance>/saveButtonText}"
          type="Emphasized"
          visible="{maintenance>/showSaveButton}"
          press=".onSave" />
        <Button
          text="Approve"
          icon="sap-icon://accept"
          type="Accept"
          visible="{= ${maintenance>/showDecisionButtons} &amp;&amp; !${env>/embedded} }"
          press=".onApprove" />
        <Button
          text="Reject"
          icon="sap-icon://decline"
          type="Reject"
          visible="{= ${maintenance>/showDecisionButtons} &amp;&amp; !${env>/embedded} }"
          press=".onReject" />
        <Button
          text="{maintenance>/cancelButtonText}"
          visible="{maintenance>/showCancelButton}"
          press=".onCancel" />
      </OverflowToolbar>
    </footer>
  </Page>
</mvc:View>
