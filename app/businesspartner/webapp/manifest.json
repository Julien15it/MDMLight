{
  "_version": "1.65.0",
  "sap.app": {
    "id": "mdm.md.businesspartner.manage",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "1.25.0"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:lrop",
      "version": "1.13.5",
      "toolsId": "mdm-md-businesspartner-manage"
    },
    "dataSources": {
      "mainService": {
        "uri": "service/businesspartner/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "odataVersion": "4.0"
        }
      },
      "changeRequestService": {
        "uri": "service/changerequest/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "odataVersion": "4.0"
        }
      }
    },
    "crossNavigation": {
      "inbounds": {
        "BusinessPartner-manage": {
          "semanticObject": "BusinessPartner",
          "action": "manage",
          "title": "{{appTitle}}",
          "subTitle": "{{appSubTitle}}",
          "signature": {
            "parameters": {},
            "additionalParameters": "allowed"
          }
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "sap-icon://blank-tag",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.120.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.ui.layout": {},
        "sap.uxap": {},
        "sap.ushell": {},
        "sap.fe.templates": {}
      }
    },
    "resourceRoots": {
      "mdm.md.businesspartner.reuse": "./reuse"
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "extends": {
      "extensions": {
        "sap.ui.controllerExtensions": {
          "sap.fe.templates.ListReport.ListReportController": {
            "controllerName": "mdm.md.businesspartner.manage.ext.controller.ListReportExtension"
          }
        }
      }
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "mdm.md.businesspartner.manage.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "synchronizationMode": "None",
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      },
      "@i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "uri": "i18n/i18n.properties"
      },
      "cr": {
        "dataSource": "changeRequestService",
        "preload": true,
        "settings": {
          "synchronizationMode": "None",
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": false
        }
      }
    },
    "resources": {
      "css": [
        {
          "uri": "reuse/css/maintenance.css"
        }
      ]
    },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "controlAggregation": "pages",
        "controlId": "appContent",
        "transition": "slide",
        "async": true,
        "viewType": "XML"
      },
      "routes": [
        {
          "pattern": ":?query:",
          "name": "BusinessPartnersList",
          "target": "BusinessPartnersList"
        },
        {
          "pattern": "BusinessPartners/create:?query:",
          "name": "BusinessPartnerCreate",
          "target": "BusinessPartnerMaintenance"
        },
        {
          "pattern": "BusinessPartners/{businessPartner}/display",
          "name": "BusinessPartnerDisplay",
          "target": "BusinessPartnerMaintenance"
        },
        {
          "pattern": "BusinessPartners/{businessPartner}/maintain",
          "name": "BusinessPartnerMaintain",
          "target": "BusinessPartnerMaintenance"
        },
        {
          "pattern": "ChangeRequests/{changeRequest}/approve",
          "name": "ChangeRequestApprove",
          "target": "BusinessPartnerMaintenance"
        },
        {
          "pattern": "ChangeRequests/{changeRequest}/edit",
          "name": "ChangeRequestEdit",
          "target": "BusinessPartnerMaintenance"
        },
        {
          "pattern": "ChangeRequests/{changeRequest}/display",
          "name": "ChangeRequestDisplay",
          "target": "BusinessPartnerMaintenance"
        },
        {
          "pattern": "ChangeRequests/{changeRequest}/rework",
          "name": "ChangeRequestRework",
          "target": "BusinessPartnerMaintenance"
        },
        {
          "pattern": "ChangeRequests",
          "name": "ChangeRequestList",
          "target": "ChangeRequestList"
        },
        {
          "pattern": "BusinessPartners({key}):?query:",
          "name": "BusinessPartnersObjectPage",
          "target": "BusinessPartnersObjectPage"
        }
      ],
      "targets": {
        "BusinessPartnersList": {
          "type": "Component",
          "id": "BusinessPartnersList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/BusinessPartnerSearchResults",
              "variantManagement": "Page",
              "navigation": {
                "BusinessPartnerSearchResults": {
                  "detail": {
                    "route": "BusinessPartnerDisplay"
                  }
                }
              },
              "initialLoad": "Disabled",
              "controlConfiguration": {
                "@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "selectionMode": "Multi"
                  },
                  "actions": {
                    "CreateBusinessPartner": {
                      "press": "mdm.md.businesspartner.manage.ext.CustomActions.openCreatePage",
                      "visible": true,
                      "enabled": true,
                      "requiresSelection": false,
                      "text": "{i18n>CreateBusinessPartner}"
                    },
                    "EditBusinessPartner": {
                      "press": "mdm.md.businesspartner.manage.ext.CustomActions.openEditPage",
                      "visible": true,
                      "enabled": "mdm.md.businesspartner.manage.ext.CustomActions.isSingleSelection",
                      "requiresSelection": true,
                      "text": "{i18n>EditBusinessPartner}"
                    },
                    "BusinessPartnerAssistant": {
                      "press": "mdm.md.businesspartner.manage.ext.CustomActions.openAssistant",
                      "visible": "{perm>/aiAssistanceEnabled}",
                      "enabled": true,
                      "requiresSelection": false,
                      "text": "Business Partner Assistant"
                    },
                    "ChangeRequests": {
                      "press": "mdm.md.businesspartner.manage.ext.CustomActions.openChangeRequests",
                      "visible": "{perm>/isDataSteward}",
                      "enabled": true,
                      "requiresSelection": false,
                      "text": "Change Requests"
                    }
                  }
                }
              }
            }
          }
        },
        "BusinessPartnerMaintenance": {
          "type": "View",
          "id": "BusinessPartnerMaintenance",
          "name": "mdm.md.businesspartner.reuse.view.BusinessPartnerMaintenance",
          "viewType": "XML"
        },
        "ChangeRequestList": {
          "type": "View",
          "id": "ChangeRequestList",
          "name": "mdm.md.businesspartner.manage.ext.view.ChangeRequestList",
          "viewType": "XML"
        },
        "BusinessPartnersObjectPage": {
          "type": "Component",
          "id": "BusinessPartnersObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "editableHeaderContent": false,
              "contextPath": "/BusinessPartners",
              "content": {
                "header": {
                  "actions": {
                    "BackToBusinessPartnersHeader": {
                      "press": "mdm.md.businesspartner.manage.ext.CustomActions.openListPage",
                      "visible": true,
                      "enabled": true,
                      "text": "Business Partners"
                    },
                    "BusinessPartnerAssistantHeader": {
                      "press": "mdm.md.businesspartner.manage.ext.CustomActions.openAssistant",
                      "visible": "{perm>/aiAssistanceEnabled}",
                      "enabled": true,
                      "text": "Ask Assistant"
                    },
                    "EditBusinessPartnerHeader": {
                      "press": "mdm.md.businesspartner.manage.ext.CustomActions.openEditCurrentPage",
                      "visible": true,
                      "enabled": true,
                      "text": "{i18n>EditBusinessPartner}"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "rootView": {
      "viewName": "sap.fe.core.rootView.NavContainer",
      "type": "XML",
      "id": "appRootView"
    }
  },
  "sap.fiori": {
    "registrationIds": [
      "F3163"
    ],
    "archeType": "transactional"
  },
  "sap.platform.abap": {
    "uri": "",
    "_version": "1.1.0"
  },
  "sap.platform.hcp": {
    "uri": "",
    "_version": "1.1.0"
  },
  "sap.cloud": {
    "public": true,
    "service": "mdm.md.businesspartner"
  }
}
